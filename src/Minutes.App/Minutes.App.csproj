<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Minutes</AssemblyName>
    <RootNamespace>Minutes.App</RootNamespace>
    <ApplicationIcon>Resources\Minutes.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Minutes</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Minutes.Core\Minutes.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\whisper-multilingual.tiktoken" LogicalName="whisper-multilingual.tiktoken" />
    <EmbeddedResource Include="Resources\Minutes.ico" LogicalName="Minutes.ico" />
    <None Include="Resources\whisper-multilingual.LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
